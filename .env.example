# Copy this file to `blockchain/.env` and fill in your own values.
# `.env` is gitignored — never commit it.

# ── Wallet ─────────────────────────────────────────────────────────────────
# Private key of the deployer wallet (without 0x prefix). Treat like a password.
PRIVATE_KEY=your-deployer-private-key-no-0x-prefix

# ── RPC endpoints ──────────────────────────────────────────────────────────
# Free RPC URL from https://www.alchemy.com or https://infura.io
POLYGON_AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_KEY
POLYGON_MAINNET_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY

# ── Polygonscan (contract verification) ────────────────────────────────────
# Free API key from https://polygonscan.com/apis
POLYGONSCAN_API_KEY=your-polygonscan-api-key
